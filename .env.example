# Copie para .env, ou gere automaticamente com: python scripts/setup_db.py
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=troque-esta-chave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco (PostgreSQL e obrigatorio)
DATABASE_URL=postgres://quadranamao:SENHA@localhost:5432/quadranamao

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0

# Somente para docker-compose
POSTGRES_PASSWORD=troque-esta-senha

# Endereco publico do sistema (links mandados por WhatsApp)
SITE_URL=http://127.0.0.1:8000

# Limite de tentativas: cache compartilhado e proxies confiaveis (producao)
# CACHE_URL=redis://localhost:6379/1
# NUM_PROXIES=1

# Pix: estatico (a equipe confirma) ou simulado (so desenvolvimento). Padrao: simulado em dev,
# estatico em producao. Ver docs/integracoes.md
# PIX_PROVIDER=estatico

# E-mail do "esqueci minha senha". Sem EMAIL_URL, o e-mail aparece no terminal do servidor.
# EMAIL_URL=smtp+tls://usuario:senha@smtp.provedor.com:587
# DEFAULT_FROM_EMAIL=QuadraNaMao! <nao-responda@seudominio.com.br>

# WhatsApp automatico: em espera (desligado). True liga o modulo. Ver docs/whatsapp.md
WHATSAPP_ENABLED=False
# console (so registra no historico) ou cloud (Cloud API da Meta)
WHATSAPP_PROVIDER=console
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
